generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// ENUMS
// =========================================================

enum Role {
  ADMIN_PUSAT
  ADMIN_CABANG
  DIREKSI
  PETUGAS
  SUPER_ADMIN
  SEKRETARIAT
  KEPALA_BAGIAN
  STAF
  VIEWER
}

enum Prioritas {
  RENDAH
  SEDANG
  TINGGI
  DARURAT
}

enum StatusAduan {
  BARU
  DIRESPONS
  PROSES
  DALAM_PENGERJAAN
  KENDALA
  SELESAI
  DITUNDA
  BATAL
}

enum JenisGangguan {
  AIR_MATI
  TEKANAN_RENDAH
  AIR_KERUH
  PIPA_BOCOR
  METER_BERMASALAH
  TAGIHAN
  SAMBUNGAN_BARU
  LAINNYA
}

enum SumberAduan {
  WHATSAPP
  DASHBOARD
  TELEPON
  LANGSUNG
}

enum TipeDokumentasi {
  FOTO_RESPONS
  FOTO_SEBELUM
  FOTO_PROSES
  FOTO_SELESAI
}

// =========================================================
// MODELS
// =========================================================

model Cabang {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String   @unique
  wilayah   String
  alamat    String?
  kontak    String?
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  petugas     Petugas[]
  aduan       Aduan[]
  pengumuman  PengumumanLayanan[]

  @@index([kode])
}

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  password    String
  nama        String
  email       String?   @unique
  role        Role      @default(ADMIN_CABANG)
  cabangId    String?
  cabang      Cabang?   @relation(fields: [cabangId], references: [id])
  aktif       Boolean   @default(true)
  pin         String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  statusLogs  StatusLog[]

  @@index([cabangId])
  @@index([role])
}

model Petugas {
  id              String   @id @default(cuid())
  nama            String
  noHp            String
  role            String   @default("Teknisi")
  cabangId        String
  cabang          Cabang   @relation(fields: [cabangId], references: [id])
  aktif           Boolean  @default(true)
  notifAduanBaru  Boolean  @default(true)
  notifDarurat    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  penugasan       PenugasanAduan[]

  @@index([cabangId])
  @@index([noHp])
}

model Aduan {
  id              String         @id
  cabangId        String
  cabang          Cabang         @relation(fields: [cabangId], references: [id])
  wilayah         String
  desa            String?
  noPelanggan     String
  namaPelanggan   String
  noHp            String
  jenisGangguan   JenisGangguan  @default(LAINNYA)
  prioritas       Prioritas      @default(SEDANG)
  status          StatusAduan    @default(BARU)
  sumberAduan     SumberAduan    @default(WHATSAPP)
  unit            String         @default("Cabang")
  keterangan      String?
  catatan         String?
  waktuMasuk      DateTime       @default(now())
  waktuRespons    DateTime?
  waktuSelesai    DateTime?
  slaJam          Int            @default(24)
  latitude        Float?
  longitude       Float?
  linkMaps        String?
  lokasiDetail    String?
  idAduanLama     String?
  alasanAlih      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  statusLogs      StatusLog[]
  dokumentasi     DokumentasiAduan[]
  penugasan       PenugasanAduan[]

  @@index([cabangId])
  @@index([status])
  @@index([waktuMasuk])
  @@index([noPelanggan])
  @@index([noHp])
}

model StatusLog {
  id               String      @id @default(cuid())
  aduanId          String
  aduan            Aduan       @relation(fields: [aduanId], references: [id], onDelete: Cascade)
  statusSebelumnya StatusAduan?
  statusBaru       StatusAduan
  waktu            DateTime    @default(now())
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  actorNama        String
  keterangan       String?

  @@index([aduanId])
  @@index([waktu])
}

model DokumentasiAduan {
  id          String           @id @default(cuid())
  aduanId     String
  aduan       Aduan            @relation(fields: [aduanId], references: [id], onDelete: Cascade)
  tipeFoto    TipeDokumentasi  @default(FOTO_PROSES)
  fotoUrl     String
  caption     String?
  uploadedBy  String
  isValid     Boolean          @default(true)
  createdAt   DateTime         @default(now())

  @@index([aduanId])
}

model PenugasanAduan {
  id         String   @id @default(cuid())
  aduanId    String
  aduan      Aduan    @relation(fields: [aduanId], references: [id], onDelete: Cascade)
  petugasId  String
  petugas    Petugas  @relation(fields: [petugasId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String

  @@index([aduanId])
  @@index([petugasId])
}

model PengumumanLayanan {
  id                String    @id @default(cuid())
  judul             String
  isi               String
  status            String    @default("AKTIF")
  mulai             DateTime
  selesai           DateTime
  cabangId          String?
  cabang            Cabang?   @relation(fields: [cabangId], references: [id])
  wilayahTerdampak  String?
  jenisDicegah      String?
  cegahAduan        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([mulai, selesai])
}

model ChatAdminQueue {
  id                   String        @id @default(cuid())
  phone                String        @unique
  nama                 String
  aduanId              String?
  status               String        @default("OPEN")
  context              String?
  lastCustomerMessage  String?
  lastCustomerAt       DateTime?
  lastAdminMessage     String?
  lastAdminAt          DateTime?
  windowExpiresAt      DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  messages             CrmMessage[]

  @@index([status])
  @@index([updatedAt])
}

model CrmMessage {
  id         String         @id @default(cuid())
  queueId    String
  queue      ChatAdminQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  sender     String
  message    String
  mediaUrl   String?
  createdAt  DateTime       @default(now())

  @@index([queueId])
  @@index([createdAt])
}

model WhatsAppLog {
  id          String   @id @default(cuid())
  phone       String
  direction   String
  messageType String
  content     String
  status      String   @default("SENT")
  createdAt   DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
